# Copie para .env (que fica fora do git) e ajuste.
# Gere uma chave nova com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_DB_PATH=/data/db.sqlite3   # no container, aponta para o volume

# Produção (compose.yaml lê .env.prod): DJANGO_DEBUG=0, chave PRÓPRIA (diferente da de dev),
# ALLOWED_HOSTS com 127.0.0.1 (usado pelo healthcheck) + o host do Tailscale, e
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<host>.<tailnet>.ts.net
